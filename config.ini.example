; MusicCatch 可选配置文件模板
; 使用方法：复制本文件为 config.ini（程序不会自动创建），按需修改后重启生效
; 配置优先级：命令行参数 > config.ini > config.py（本文件未列出的项保持 config.py 默认值）
; 键名 = config.py 常量名（不区分大小写，如 port / PORT / lt_transport 均可）
; 布尔值写法：true/false、yes/no、on/off、1/0

[basic]
; 调试日志开关（true/false）：开启后输出 INFO+/DEBUG+ 调试日志，关闭仅 WARNING+
debug = false
; 监听地址
host = 0.0.0.0
; 监听端口
port = 8000
; 访问密码（保护登录等敏感接口），空字符串表示不启用；支持 $sha256$<salt>$<hexdigest> 哈希格式
password = musiccatch
; 以 HTTPS 对外提供服务（TLS 在反向代理层终止时设为 true）
https = false
; 由本程序直接加载证书提供 HTTPS（不经反向代理时使用）
ssl = false
; SSL 证书文件路径
ssl_certfile = cert.pem
; SSL 私钥文件路径
ssl_keyfile = key.pem
; https 模式下可信代理 IP 白名单（逗号分隔）
forwarded_allow_ips = 127.0.0.1
; 是否支持视频播放（B 站）：关闭后 B 站仅播放/下载音频
video_playback_enabled = false

[rate]
; 每 IP 每分钟最多请求数（gate 注册）
rate_max = 5
; 速率限制窗口（秒）
rate_window = 60
; 普通 API 每 IP 每分钟上限（token 校验通过后仍限速）
api_rate_max = 60
; 流式端点（proxy/download）限速上限
stream_rate_max = 600
; gate 心跳限速
heartbeat_rate_max = 60
; 密码验证限速（防爆破）
auth_verify_rate_max = 10

[proxy]
; 代理允许的域名后缀（逗号分隔）
allowed_proxy_domains = 163.com, 126.net, kugou.com, bilibili.com, bilivideo.com, hdslb.com, akamaized.net
; 代理允许的端口（逗号分隔）
allowed_proxy_ports = 80, 443
; 代理最大重定向跳数（每跳重新校验）
proxy_max_redirects = 3
; 防盗链 Referer 映射（"域名=Referer" 逗号分隔，覆盖默认表）
proxy_referer_map = 163.com=https://music.163.com/, 126.net=https://music.163.com/, kugou.com=https://www.kugou.com/, bilibili.com=https://www.bilibili.com/, bilivideo.com=https://www.bilibili.com/, hdslb.com=https://www.bilibili.com/, akamaized.net=https://www.bilibili.com/

[cookie]
; 认证 Cookie 名称
auth_cookie_name = mc_auth
; 认证 Cookie 有效期（秒）
auth_cookie_max_age = 604800

[frozen]
; 打包启动后延迟打开浏览器（秒）
frozen_browser_open_delay = 1.5

[gate]
; 门禁验证通过后有效时长（秒），滑动续期
gate_token_ttl = 15
; 门禁注册后待验证时长（秒）
gate_pending_ttl = 3
; 挑战页脚本 token 有效期（秒）
gate_script_ttl = 3
; 门禁 Cookie 名称
gate_cookie_name = mc_gate
; 门禁 Cookie 有效期（秒）
gate_cookie_max_age = 86400
; 门禁心跳间隔（毫秒）
gate_heartbeat_interval = 10000
; 门禁注册失败重试延迟（毫秒）
gate_reload_timeout = 500
; 门禁注册成功后刷新前等待（毫秒）
gate_reload_delay = 1000

[af12]
; 窗口尺寸差异阈值下限（px）
af12_threshold_min = 140
; 窗口尺寸差异阈值上限（px）
af12_threshold_max = 180
; 尺寸检测间隔下限（毫秒）
af12_interval_min = 800
; 尺寸检测间隔上限（毫秒）
af12_interval_max = 1200
; debugger 检测间隔下限（毫秒）
af12_debug_interval_min = 1800
; debugger 检测间隔上限（毫秒）
af12_debug_interval_max = 3200
; debugger 断点判定阈值（毫秒）
af12_debug_delay_threshold = 100
; 反 F12 调试模式（销毁动作改为 debugger + 日志，定位误杀用，定位后置 false 恢复硬销毁）
af12_debug_mode = false
; resize 防抖延迟（毫秒）
af12_resize_debounce = 300

[http]
; HTTP 客户端 User-Agent
http_user_agent = Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0.0.0 Safari/537.36
; 建立连接超时（秒）
download_timeout_connect = 30
; 流式读取超时（秒）
download_timeout_read = 300
; HEAD 请求读取超时（秒）
head_timeout_read = 30
; 代理流式传输块大小（字节）
proxy_chunk_size = 65536

[listen_together]
; 传输方式："http"（长轮询，兼容不支持 WS 的 CDN）或 "ws"（低延迟推送），全局统一
lt_transport = http
; WebSocket 连接地址覆盖（配置完整 WS 地址如 wss://ws.example.com/api/listen-together/ws 时前端从该地址连接，空=当前域名）
lt_ws_url = 
; 常驻房间数
lt_room_count = 10
; 单房间播放队列上限（防内存滥用）
lt_queue_max = 100
; 用户名 / 自定义房间名最大长度（前端提示/输入框上限统一跟随此值）
lt_name_max_len = 20
; 用户名活动记录宽限（秒）
lt_name_ttl = 600
; 房间列表自动刷新间隔（毫秒）
lt_rooms_refresh = 10000
; 房主播放位置同步上报间隔（毫秒）
lt_sync_interval = 5000
; 长轮询最长挂起（秒）
lt_poll_timeout = 20
; 成员离线判定（秒）
lt_member_ttl = 90
; 房间播放缓存余量（秒）：播放中持续续期，切歌/停止后超过此时长自动删除
lt_cache_margin = 300

[body]
; 请求体（JSON 等）大小上限（字节）
max_body_size = 1048576
